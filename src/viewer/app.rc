#include <winver.h>
#include "Version.h"

IDI_ICON1 ICON "../../images/vx.ico"

1 VERSIONINFO
 FILEVERSION     PF_VERSION_MAJOR,PF_VERSION_MINOR,PF_VERSION_PATCH,0
 PRODUCTVERSION  PF_VERSION_MAJOR,PF_VERSION_MINOR,PF_VERSION_PATCH,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ViitorX"
            VALUE "FileDescription",  "ViitorXPC PointCloud Viewer"
            VALUE "FileVersion",      PF_VERSION_STRING
            VALUE "ProductName",      "ViitorXPC"
            VALUE "ProductVersion",   PF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
